# Mesh API (required — all LLM/embedding calls go through Mesh)
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
MESH_EMBEDDING_DIM=1536

# App
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///./data/smartreco.db

# Vector store (Qdrant). Leave QDRANT_URL empty to use local embedded mode
# (no server needed, good for local dev). Set both to use a real Qdrant
# server or Qdrant Cloud (recommended for deployment).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant

# Seeded admin account (created by app/seed.py)
ADMIN_EMAIL=admin@smartreco.local
ADMIN_PASSWORD=change-me

# Recommendation trigger tuning
RECOMMENDATION_EVENT_THRESHOLD=5
RECOMMENDATION_FIRST_EVENT_THRESHOLD=3
RECOMMENDATION_COOLDOWN_MINUTES=5

# Scheduler
SCHEDULER_REFRESH_MINUTES=20
DIGEST_HOUR=17
DIGEST_MINUTE=0

# SMTP (optional — if unset, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=smartreco@example.com

# LangSmith (optional bonus tracing — no app code change needed, these are
# read directly by the langsmith/langchain SDKs, not by our own Settings)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco

# NOT used by this app — all LLM/embedding calls go through Mesh only, per
# the challenge rules, so a direct Anthropic key has nothing to plug into.
# Only relevant if you separately give a langsmith/langchain example project
# its own Claude access; harmless to leave unset here.
# ANTHROPIC_API_KEY=

# Submission
SUBMISSION_TOKEN=
